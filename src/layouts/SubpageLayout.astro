---
import BaseLayout from './BaseLayout.astro';
import galleryImagesData from '../gallery-data.json';

interface Faq {
  question: string;
  answer: string;
}
interface Section {
  heading: string;
  body: string;
}
interface Related {
  href: string;
  title: string;
  text: string;
}

interface Props {
  slug: string;
  title: string;
  description: string;
  crumb: string;
  intro?: string;
  sections: Section[];
  faq: Faq[];
  related: Related[];
  showGallery?: boolean;
  galleryAlt?: string;
}

const { slug, title, description, crumb, intro, sections, faq, related, showGallery = false, galleryAlt = 'Dique Piscu Yaco' } = Astro.props as Props;
const site = Astro.site ? Astro.site.href.replace(/\/$/, '') : 'https://diquepiscuyaco.com';
const canonical = `${site}/es/${slug}`;
const alternates = { es: canonical };
const galleryImages = (galleryImagesData as string[]).map((src) => ({ src }));

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${site}/es` },
    { '@type': 'ListItem', position: 2, name: crumb, item: canonical },
  ],
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};

function renderText(text: string): string {
  if (!text) return '';
  return text
    .split(/(\*\*.*?\*\*)/g)
    .map((part) => {
      if (part.startsWith('**') && part.endsWith('**')) return `<strong>${part.slice(2, -2)}</strong>`;
      return part;
    })
    .join('');
}
---

<BaseLayout
  locale="es"
  title={title}
  description={description}
  ogTitle={title.split(' | ')[0]}
  ogDescription={description}
  pathOverride={`/es/${slug}`}
  alternates={alternates}
  includeSchema={false}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbLd)}></script>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)}></script>

  <!-- Top bar -->
  <nav class="sub-topbar">
    <a href="/es" class="sub-brand">Dique Piscu Yaco</a>
    <a href="/es" class="sub-back">← Volver al inicio</a>
  </nav>

  <!-- Hero -->
  <header class="sub-hero">
    <div class="sub-hero-inner">
      <nav class="sub-breadcrumb" aria-label="Breadcrumb">
        <a href="/es">Inicio</a><span> / </span><span>{crumb}</span>
      </nav>
      <h1 class="sub-title">{title.split(' | ')[0]}</h1>
      {intro && <p class="sub-intro" set:html={renderText(intro)}></p>}
    </div>
  </header>

  <!-- Content -->
  <main class="sub-main">
    {
      sections.map((sec) => (
        <section class="sub-section">
          <h2 class="sub-h2">{sec.heading}</h2>
          <div class="sub-prose" set:html={renderText(sec.body)}></div>
        </section>
      ))
    }

    <!-- Gallery (optional) -->
    {
      showGallery && galleryImages.length > 0 && (
        <section class="sub-section">
          <h2 class="sub-h2">Galería de fotos</h2>
          <div class="sub-gallery">
            {galleryImages.map((item) => (
              <div class="sub-gallery-item">
                <img src={item.src} alt={galleryAlt} loading="lazy" />
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- FAQ -->
    {
      faq.length > 0 && (
        <section class="sub-section">
          <h2 class="sub-h2">Preguntas frecuentes</h2>
          <div class="faq-list">
            {faq.map((f) => (
              <div class="faq-item">
                <button class="faq-question" data-faq type="button">
                  <span style="color:var(--color-deep);font-weight:600;">{f.question}</span>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="faq-icon">
                    <path d="M6 9l6 6 6-6"></path>
                  </svg>
                </button>
                <div class="faq-answer">
                  <p set:html={renderText(f.answer)}></p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Related cluster pages -->
    {
      related.length > 0 && (
        <section class="sub-section">
          <h2 class="sub-h2">También te puede interesar</h2>
          <div class="sub-related">
            {related.map((r) => (
              <a href={r.href} class="cluster-card">
                <h4 style="font-family:var(--font-display);font-size:1.1rem;font-weight:600;color:var(--color-deep);margin:0 0 0.5rem;">{r.title}</h4>
                <p style="font-size:0.85rem;color:var(--color-earth-soft);line-height:1.5;margin:0;">{r.text}</p>
                <span style="display:inline-block;margin-top:0.75rem;font-size:0.8rem;font-weight:600;color:var(--color-mountain);">Leer guía →</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>

  <footer class="site-footer">
    <div class="footer-links">
      <p class="footer-links-title">Enlaces útiles</p>
      <div class="footer-links-grid">
        <a href="/es" class="footer-link-item">Dique Piscu Yaco — Guía principal</a>
        <a href="https://villademerlo.tur.ar" target="_blank" rel="noopener noreferrer" class="footer-link-item">Turismo Villa de Merlo</a>
        <a href="https://turismo.sanluis.gob.ar" target="_blank" rel="noopener noreferrer" class="footer-link-item">Turismo San Luis</a>
      </div>
    </div>
    <p class="footer-text" style="margin-top:1.5rem;">
      Guía independiente sin fines de lucro · <a href="/es" style="color:var(--color-gold);text-decoration:none;">diquepiscuyaco.com</a>
    </p>
  </footer>

  <script>
    // Reveal-on-scroll for subpage sections
    const reveals = document.querySelectorAll('.sub-section');
    if ('IntersectionObserver' in window) {
      const obs = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('visible');
              obs.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      reveals.forEach((el) => obs.observe(el));
    } else {
      reveals.forEach((el) => el.classList.add('visible'));
    }

    // FAQ accordion
    document.querySelectorAll<HTMLButtonElement>('.faq-question[data-faq]').forEach((q) => {
      q.addEventListener('click', () => {
        const item = q.closest('.faq-item');
        if (!item) return;
        const expanded = item.classList.toggle('expanded');
        q.querySelector('.faq-icon')?.classList.toggle('rotated', expanded);
      });
    });
  </script>
</BaseLayout>

<style>
  .sub-topbar {
    position: sticky;
    top: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.5rem;
    background: rgba(26, 46, 26, 0.94);
    backdrop-filter: blur(12px);
  }
  .sub-brand {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }
  .sub-back {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }
  .sub-back:hover { color: #fff; }

  .sub-hero {
    padding: 4rem 1.5rem 3rem;
    background:
      linear-gradient(180deg, rgba(26, 46, 26, 0.82), rgba(26, 46, 26, 0.92)),
      url('/gallery/dique-piscu-yaco-03.jpg');
    background-size: cover;
    background-position: center;
  }
  .sub-hero-inner { max-width: 900px; margin: 0 auto; }
  .sub-breadcrumb { font-size: 0.8rem; color: rgba(255, 255, 255, 0.7); margin-bottom: 1.25rem; }
  .sub-breadcrumb a { color: rgba(255, 255, 255, 0.9); text-decoration: none; }
  .sub-breadcrumb a:hover { text-decoration: underline; }
  .sub-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.4rem);
    font-weight: 700;
    line-height: 1.05;
    color: #fff;
    margin: 0;
  }
  .sub-intro {
    margin-top: 1.25rem;
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.88);
    max-width: 680px;
  }
  .sub-intro strong { color: var(--color-gold-light); }

  .sub-main { max-width: 820px; margin: 0 auto; padding: 1rem 1.5rem 3rem; }
  .sub-section { padding: 2.25rem 0; border-bottom: 1px solid rgba(0, 0, 0, 0.06); }
  .sub-section:last-child { border-bottom: none; }
  .sub-h2 {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 700;
    color: var(--color-deep);
    margin: 0 0 1.25rem;
  }
  .sub-prose { font-size: 1.02rem; line-height: 1.85; color: var(--color-earth-soft); }
  .sub-prose p { margin: 0 0 1.1rem; }
  .sub-prose ul { padding-left: 1.4rem; margin: 0 0 1.1rem; }
  .sub-prose li { margin-bottom: 0.5rem; }
  .sub-prose strong { color: var(--color-deep); }

  .sub-related {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  .sub-gallery {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
  }
  .sub-gallery-item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 2px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
  }
  .sub-gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }
  .sub-gallery-item:hover img { transform: scale(1.04); }

  .sub-section { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .sub-section.visible { opacity: 1; transform: translateY(0); }
</style>
